[Unit]
Description=SharipovAI metadata-only future model readiness
After=docker.service
Requires=docker.service
StartLimitIntervalSec=2h
StartLimitBurst=100

[Service]
Type=exec
WorkingDirectory=/opt/sharipovai-repo
ExecStart=/usr/bin/bash /opt/sharipovai-repo/deploy/vps/model_readiness_check.sh
RuntimeMaxSec=180
# Retry only expected resource deferrals; genuine checker failures stay failed.
SuccessExitStatus=75 76
RestartForceExitStatus=75
# Hourly exports can leave only a 60–90 second gap. Ten-minute retries
# can repeatedly miss it. Lock-busy attempts exit before resource checks or scans.
# At most 100 starts per two hours; 99 minutes also covers a 75-minute export.
RestartSec=1min
CPUQuota=25%
MemoryMax=256M
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
