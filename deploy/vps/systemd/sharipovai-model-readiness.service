[Unit]
Description=SharipovAI metadata-only future model readiness
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/sharipovai-repo
ExecStart=/usr/bin/bash /opt/sharipovai-repo/deploy/vps/model_readiness_check.sh
TimeoutStartSec=180
CPUQuota=25%
MemoryMax=256M
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
