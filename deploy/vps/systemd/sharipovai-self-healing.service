[Unit]
Description=SharipovAI bounded self-healing cycle
Documentation=https://github.com/samandarsharipov2214/SharipovAI
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/opt/sharipovai-repo/deploy/vps/docker-compose.yml

[Service]
Type=oneshot
User=root
Group=root
Environment=SHARIPOVAI_REPO_DIR=/opt/sharipovai-repo
ExecStart=/usr/local/sbin/sharipovai-self-healing-run
TimeoutStartSec=25min
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=multi-user.target
